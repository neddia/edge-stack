# Secrets and endpoints (fill in real values for a site)

# InfluxDB (the data compose writes site-agent token into /secrets/influx.token)
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=edge-org
INFLUX_BUCKET=edge-site
INFLUX_RETENTION=30d
INFLUX_TOKEN_FILE=/secrets/influx.token

# ChirpStack gRPC for downlinks
CS_GRPC_SERVER=chirpstack:8080
CS_GRPC_TOKEN=
CS_FPORT=1
DEFAULT_DEV_EUI=REPLACE_ME
LORA_CHUNK_CAP=220

# MQTT uplinks from ChirpStack
MQTT_HOST=chirpstack-mqtt:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPICS=["application/+/device/+/event/up"]
# MQTT_DOWNLINK_TOPIC=application/1/device/XYZ/command/down

# Site-agent basics
SITE_CONFIG_PATH=/app/storage/site-config.yml
PROFILES_DIR=/app/storage/profiles
LOG_LEVEL=INFO
