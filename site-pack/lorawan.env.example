# Optional env passed to ChirpStack compose.
# Copy to site-pack/lorawan.env (kept out of git) and fill real values.

CHIRPSTACK_URL=http://chirpstack:8080
CHIRPSTACK_TENANT_ID=REPLACE
CHIRPSTACK_APP_NAME=site-app
# Admin creds (unused since the HTTP init overlay was removed)
CHIRPSTACK_ADMIN_EMAIL=admin@example.com
CHIRPSTACK_ADMIN_PASSWORD=CHANGE_ME
